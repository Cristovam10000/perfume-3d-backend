# Copie para .env e ajuste conforme seu ambiente.

APP_NAME=perfume-3d-backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (driver async).
# Container local: tcc-postgres (host=localhost, porta=5433, db=tcc).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/tcc

# Armazenamento local (relativo ao diretorio do backend, ou caminho absoluto).
# Cria: storage/uploads, storage/models, storage/cache.
STORAGE_ROOT=./storage

# CORS (separado por virgula; * libera tudo - util para o emulador Android).
CORS_ORIGINS=*

# ---- Pipeline 3D ----
# fake       = FakeProcessor (cubo sintetico, ~3s, sem deps externas)
# template   = TemplateProcessor (Blender headless, ~5-15s, sem cache nem Hunyuan)
# integrated = IntegratedPipeline (preprocess + rembg + cache CLIP + Hunyuan + refiner + label) - default em prod
PIPELINE_MODE=integrated

# Se true e o Hunyuan falhar, cai no TemplateProcessor em vez de marcar o job como erro.
PIPELINE_FALLBACK_TO_TEMPLATE=false

# Blender (necessario em PIPELINE_MODE=integrated ou template).
BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
TEMPLATES_DIR=./assets/templates/normalized
DEFAULT_TEMPLATE_ID=rectangular_basic

# ---- Hunyuan3D-2mv (cliente HTTP) ----
HUNYUAN_URL=http://localhost:7860
HUNYUAN_TIMEOUT_SECONDS=1200
HUNYUAN_OCTREE_RESOLUTION=512
HUNYUAN_NUM_INFERENCE_STEPS=75
HUNYUAN_GUIDANCE_SCALE=7.5
HUNYUAN_MC_ALGO=mc
HUNYUAN_TEXTURE_RESOLUTION=2048

# ---- Cache de modelos (similaridade CLIP) ----
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_EMBEDDER_TYPE=clip
CACHE_EMBEDDING_MODEL=openai/clip-vit-base-patch32

# ---- View router (rotulagem de vistas pro Hunyuan3D-2mv) ----
# Quando o app envia `views` no upload, esses labels têm prioridade
# (LabeledViewRouter). Esta variável só decide o fallback quando o
# cliente NÃO envia labels.
# positional = ordem do upload vira front/left/back/right (legado).
# clip       = CLIPViewRouter zero-shot.
VIEW_ROUTER_TYPE=clip

# ---- Stages auxiliares do pipeline IA ----
IMAGE_PREPROCESSOR_TYPE=standard
BACKGROUND_REMOVER_TYPE=rembg
# Modelo do rembg:
#   birefnet-general    = SOTA p/ vidro/transparência (~885MB, recomendado).
#   birefnet-general-lite = mais rápido com qualidade próxima (~225MB).
#   isnet-general-use   = mais leve (~178MB), default histórico.
#   u2net               = default original do rembg, qualidade menor.
BACKGROUND_REMOVER_MODEL=birefnet-general
MESH_CLEANER_TYPE=blender
# 0.0 = preserva todas as ilhas. 0.05 = remove ilhas <5% do tamanho da maior
# (recomendado: limpa fragmentos do Hunyuan sem mexer em pedaços úteis).
MESH_MIN_ISLAND_RATIO=0.05
MESH_REFINER_TYPE=blender
LABEL_EXTRACTOR_TYPE=homography
LABEL_UPSCALER_TYPE=lanczos
LABEL_PROJECTOR_TYPE=blender
LABEL_FRONT_AXIS=front_y_neg
LABEL_MIN_CONFIDENCE=0.3
LABEL_TARGET_SIZE=2048

# ---- Legado (mantido por compat; lido com warning de deprecation) ----
# COLOR_DETECTOR_TYPE so faz sentido em PIPELINE_MODE=template
# (no integrated o Hunyuan ja infere a cor a partir das fotos).
COLOR_DETECTOR_TYPE=disabled
# CLASSIFIER_TYPE foi substituido por CACHE_EMBEDDER_TYPE.
# CLASSIFIER_TYPE=disabled
# PROCESSOR_TYPE foi substituido por PIPELINE_MODE.
# PROCESSOR_TYPE=fake
