# Copie para .env e ajuste conforme seu ambiente.

APP_NAME=perfume-3d-backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (driver async)
# Container local existente: tcc-postgres (host=localhost, porta=5433, db=tcc).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/tcc

# Armazenamento local (relativo ao diretorio do backend, ou caminho absoluto)
STORAGE_ROOT=./storage

# CORS (separado por virgula; * libera tudo - util para o emulador Android)
CORS_ORIGINS=*

# Pipeline 3D
# fake     = FakeProcessor (cubo sintetico, rapido, sem deps externas) - default
# template = TemplateProcessor (customiza um GLB via Blender headless)
PROCESSOR_TYPE=fake

BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
TEMPLATES_DIR=./assets/templates/normalized

# Classificador de forma do frasco (CLIP)
# disabled = sempre usa DEFAULT_TEMPLATE_ID (sem deps extras) - default
# clip     = OpenAI CLIP via transformers/torch (~2GB extra)
CLASSIFIER_TYPE=disabled
CLIP_MODEL=openai/clip-vit-base-patch32
DEFAULT_TEMPLATE_ID=rectangular_basic

# Detector de cor do liquido
# disabled = template usa cor padrao do material - default
# average  = RGB medio do crop central das fotos (requer Pillow)
COLOR_DETECTOR_TYPE=disabled
